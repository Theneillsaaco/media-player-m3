<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="Domain/Track.fs" />
    <Compile Include="Domain/RepeatMode.fs" />
    <Compile Include="Domain/Listen.fs" />
    <Compile Include="Contracts/Audio.fs" />
    <Compile Include="Contracts/Provider.fs" />
    <Compile Include="Contracts/Scrobbler.fs" />
    <Compile Include="Scrobbling/Scrobble.fs" />
    <Compile Include="Playback/Queue.fs" />
    <Compile Include="Playback/Listening.fs" />
    <Compile Include="Logging.fs" />
  </ItemGroup>
</Project>
