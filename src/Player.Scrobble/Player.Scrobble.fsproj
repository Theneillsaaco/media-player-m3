<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" Version="10" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="LastFm\Signing.fs" />
      <Compile Include="LastFm\Config.fs" />
      <Compile Include="LastFm\Client.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Player.Core\Player.Core.fsproj" />
    </ItemGroup>

</Project>
